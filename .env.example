# RailQR Companion Portal (UDM + TMS)
# Copy this file to .env and fill in your production values.
# NEVER commit the real .env file — it is listed in .gitignore.

# ── Flask ─────────────────────────────────────────────────────────────────────
# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Admin portal password
ADMIN_PASSWORD=admin1234

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty on Vercel (uses /tmp copy of bundled companion_data.db).
# Set to an absolute path when running locally if you want a custom location.
UDM_DB_PATH=

# ── GaugeMarket integration ───────────────────────────────────────────────────
# URL of the GaugeMarket/RailQR deployment (no trailing slash)
GAUGEMARKET_URL=https://rail-qr-marketplace.vercel.app

# Shared secret for server-to-server calls between GaugeMarket and UDM/TMS.
# Must match GAUGEMARKET_INTERNAL_SECRET set in GaugeMarket's Vercel env vars.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GAUGEMARKET_INTERNAL_SECRET=your-shared-secret-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser-side cross-origin requests.
# Always include the GaugeMarket production URL.
ALLOWED_ORIGINS=https://rail-qr-marketplace.vercel.app,http://localhost:5000,http://127.0.0.1:5000
